{
  "name": "productr-fullstack",
  "version": "1.0.0",
  "description": "Productr Fullstack MERN Application",
  "scripts": {
    "install-server": "npm install --prefix server --include=dev",
    "install-client": "npm install --prefix client --include=dev",
    "install-all": "npm run install-server && npm run install-client",
    "build-client": "npm run build --prefix client",
    "build": "npm run install-all && npm run build-client",
    "start": "node server/server.js"
  },
  "engines": {
    "node": ">=16.0.0"
  }
}
